# Copy to .env and fill in. Never commit .env.

# --- LLM (any OpenAI-compatible chat-completions endpoint) ---
LLM_BASE_URL=<LLM_BASE_URL>      # e.g. the /v1 root of your OpenAI-compatible server
LLM_API_KEY=<LLM_API_KEY>        # leave empty if the server needs no key
LLM_MODEL=<LLM_MODEL>

# --- Safety (all optional) ---
# Comma-separated hostnames the browser may visit. If empty, only the start URL's host is allowed.
ALLOWED_DOMAINS=<ALLOWED_DOMAIN_1>,<ALLOWED_DOMAIN_2>
# MAX_STEPS=            # unset = no limit on tool calls
# STEP_TIMEOUT=60       # seconds per tool call
# MAX_CONSECUTIVE_FAILURES=3

# --- Playwright MCP launch (optional overrides) ---
# MCP_COMMAND=npx
# MCP_ARGS=@playwright/mcp@latest

# --- Live view (all optional; CLI flags override) ---
# LIVE_MODE=cdp           # cdp | screenshot | off (default: off, or cdp when --live is used)
# LIVE_HOST=127.0.0.1     # viewer bind address; non-local values expose the viewer
# LIVE_PORT=0             # 0 = any free port
# LIVE_FPS=5              # max live frames per second
# LIVE_MAX_WIDTH=1280
# LIVE_MAX_HEIGHT=800
# LIVE_QUALITY=60         # JPEG quality of live frames
# LIVE_MAX_FRAME_KB=600   # larger frames are dropped
# SLOW_MO=0               # ms to wait after each action
# BROWSER_PATH=<PATH_TO_CHROME_OR_CHROMIUM>   # cdp mode; auto-detected when empty

# --- Test data, referenced in suites as {{env:TEST_USER}} / {{env:TEST_PASSWORD}} ---
TEST_USER=<TEST_USER>
TEST_PASSWORD=<TEST_PASSWORD>

# Used by examples/suite.template.yaml via ${TARGET_URL}
TARGET_URL=<TARGET_URL>
